# Application Core Configuration
PROJECT_NAME="PalmMind AI - Document RAG & Interview Booking Assistant"
ENVIRONMENT="development"
DEBUG=True
API_V1_PREFIX="/api/v1"
HOST="0.0.0.0"
PORT=8000
LOG_LEVEL="INFO"

# LLM Configuration (Google Gemini API)
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-2.5-flash"

# Embedding Model Configuration (Sentence Transformers)
EMBEDDING_MODEL_NAME="all-MiniLM-L6-v2"
EMBEDDING_DIMENSION=384

# Vector Database (Qdrant)
QDRANT_HOST="localhost"
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION="palmind_docs"

# Conversational Memory (Redis)
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_DB=0
REDIS_SESSION_TTL_SECONDS=86400
REDIS_HISTORY_LIMIT=10

# Metadata & Booking Persistence (SQLite)
DATABASE_URL="sqlite:///./palmind.db"

# File Ingestion Limits
MAX_UPLOAD_SIZE_MB=10
ALLOWED_FILE_TYPES=["pdf", "txt"]

# Chunking Strategy Defaults
DEFAULT_FIXED_CHUNK_SIZE=500
DEFAULT_FIXED_CHUNK_OVERLAP=50
DEFAULT_RECURSIVE_CHUNK_SIZE=500
DEFAULT_RECURSIVE_CHUNK_OVERLAP=50

